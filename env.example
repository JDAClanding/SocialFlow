# Copy this file to .env and fill in what you have. Everything is optional —
# the server runs with zero keys using free web search and a local
# placeholder image generator, so the app is fully click-through testable
# out of the box.

# --- Image generation (lib/screens/studio_screen.dart already has fields
#     for these — filling one in here makes it "ready" for every device,
#     with no per-device key needed) ---
FAL_KEY=
REPLICATE_API_TOKEN=
GEMINI_API_KEY=
STABILITY_API_KEY=
OPENAI_API_KEY=

# --- Official Meta Ad Library API (optional). Without it, /api/metaads
#     falls back to an image-search approximation. ---
FB_ACCESS_TOKEN=

# --- Server ---
PORT=8080
